<?xml version="1.0" encoding="utf-8"?>
<!--
    CrossHealth - Android Manifest Template
    
    This manifest fragment is merged with the main AndroidManifest.xml during build.
    It declares the Health Connect permissions and intent filters required by the plugin.
    
    Place in Assets/CrossHealth/Plugins/Android/
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect Read Permissions -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />

    <application>
        <!--
            Health Connect requires an activity with a specific intent filter
            to handle the permission rationale screen.
            This tells Health Connect which activity should show why your
            app needs health data access.
        -->
        <activity
            android:name="com.crosshealth.bridge.PermissionRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
            For Android 14+, declare the health permissions rationale activity
            using the new activity-alias approach.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.crosshealth.bridge.PermissionRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
